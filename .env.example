# ─────────────────────────────────────────────────
# 공통 기본값 + Docker Compose 전용 변수 템플릿
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다.
# 환경별 설정은 별도 파일에 나눠 적는다.
#   - 로컬 개발:  .env.local        (APP_ENV 미설정 시 자동 사용)
#   - 테스트:     .env.test         (APP_ENV=test)
#   - 실서버:     .env.production   (APP_ENV=production, 템플릿: .env.production.example)
#
# 읽는 순서: .env  →  .env.{APP_ENV}   (뒤에 오는 값이 이긴다)
#
# 주의: docker-compose.yml은 .env만 읽고 .env.local은 읽지 않는다.
#      DB_*, PGADMIN_* 변수는 반드시 .env 에 있어야 컨테이너가 뜬다.
# ─────────────────────────────────────────────────

# ── App ──────────────────────────────────────────
APP_NAME=나의 일기(내일) API
APP_VERSION=0.1.0

# ── Database (Docker Compose가 컨테이너를 만들 때 사용) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nailgi
DB_USER=nailgi
DB_PASSWORD=your_password_here

# ── pgAdmin (Docker Compose 전용) ─────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ── Redis (Docker Compose 전용 포트) ──────────────
REDIS_PORT=6379

# ── JWT 공통 정책 ─────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=15

# ─────────────────────────────────────────────────
# 아래 값들은 환경별 파일(.env.local 등)에서 설정한다.
#
#   DATABASE_URL=postgresql://nailgi:비밀번호@localhost:5432/nailgi
#   JWT_SECRET_KEY=임의의-긴-문자열
#   CORS_ORIGINS=http://localhost:5173
#   STORAGE_BACKEND=local                          # local | s3
#   UPLOAD_DIR=uploads
#   MEDIA_BASE_URL=http://127.0.0.1:8000/uploads
#   REDIS_URL=redis://localhost:6379/0             # 웹 세션 저장소 (테스트는 /1)
#   LOG_LEVEL=INFO                                 # DEBUG면 커넥션 대여/반납까지 표시
#   DB_ECHO=false                                  # true면 실행되는 SQL 전문을 모두 기록
#   DB_LOG_CONNECTIONS=true                        # DB 커넥션 생성/종료 로그
#   SERVICE_TIMEZONE=Asia/Seoul                    # ?from=날짜 조회를 어느 시간대의 하루로 볼지
#   PLACE_SEARCH_PROVIDER=mock                     # 지도 공급자 확정 전까지 mock
#
# 실서버에서 S3로 바꿀 때는 STORAGE_BACKEND=s3 로 두고
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_BUCKET_NAME / AWS_REGION 을 채운다.
# ─────────────────────────────────────────────────
