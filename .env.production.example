# ─────────────────────────────────────────────────
# 실서버 환경 템플릿 (APP_ENV=production)
#
# 이 파일은 예시이며 실제 값이 들어가면 안 된다.
# 배포 서버에서 .env.production 으로 복사한 뒤 실제 값을 채운다.
# .env.production 은 절대 커밋하지 않는다 (.gitignore 처리됨).
# ─────────────────────────────────────────────────

APP_ENV=production

# ── Database ──────────────────────────────────────
# 실서버 DB 주소. 로컬과 달리 반드시 강한 비밀번호를 쓴다.
DATABASE_URL=postgresql://실제계정:실제비밀번호@DB호스트:5432/nailgi

# ── JWT ───────────────────────────────────────────
# 반드시 임의의 긴 문자열로 새로 만든다. 로컬 값을 재사용하면 안 된다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=반드시-새로-생성한-임의값으로-교체

# ── CORS ──────────────────────────────────────────
# 실제 서비스 도메인만 허용한다. localhost를 남겨두면 안 된다.
CORS_ORIGINS=https://내도메인.com

# ── Redis (웹 세션 저장소) ────────────────────────
REDIS_URL=redis://redis호스트:6379/0

# 실서버는 HTTPS이므로 반드시 true. false로 두면 세션 쿠키가 평문으로 오간다.
SESSION_COOKIE_SECURE=true
# 프론트와 API가 다른 서브도메인이면 상위 도메인을 지정한다 (예: .내도메인.com)
SESSION_COOKIE_DOMAIN=

# ── 사진 저장소 (AWS S3) ──────────────────────────
# 버킷·권한·공개 설정은 docs/DEPLOYMENT_CHECKLIST.md 1.1을 따른다.
# 버킷 이름이 비어 있으면 서버가 시작하지 않는다.
STORAGE_BACKEND=s3
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
# EC2에 IAM 역할을 붙였다면 두 줄 다 비워 둔다. 비어 있으면 역할에서 자격 증명을 가져온다.
# 역할을 못 쓰는 곳에서만 IAM 사용자 키를 넣는다. 실제 값은 커밋 금지.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 사진 주소 앞부분. DB에는 키만 저장되고 이 값이 앞에 붙는다.
# CloudFront(권장): https://배포주소.cloudfront.net
# 버킷 공개 읽기:   https://버킷이름.s3.ap-northeast-2.amazonaws.com
MEDIA_BASE_URL=https://배포주소.cloudfront.net

# ── 장소 검색 (카카오) ────────────────────────────
# 빠뜨리면 기본값 mock이 쓰여 실서버 장소 검색·코스 추천이 가짜 장소를 돌려준다.
PLACE_SEARCH_PROVIDER=kakao
# 서버 전용 REST 키. 브라우저·앱에 넣지 않는다.
KAKAO_REST_API_KEY=
KAKAO_SEARCH_TIMEOUT_SECONDS=5
