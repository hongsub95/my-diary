# Android emulator
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# iOS simulator: http://localhost:8000/api/v1
# Physical device: http://{YOUR_PC_LAN_IP}:8000/api/v1
# 네이티브 WebView 지도의 기준 주소. 카카오 JavaScript SDK 도메인에 등록한다.
# 웹 실행은 실제 웹 주소(예: http://localhost:8081)를 등록한다.
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=http://localhost:8081/
# KAKAO_JAVASCRIPT_KEY는 루트 .env에서 읽는다. REST 키는 앱에 포함하지 않는다.
